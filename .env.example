# ==========================================
# 仅放敏感项（及 docker 基础设施口令）
# 业务默认值、模型名、URL 等写在 config.yml
# 复制为 .env 后填写，勿提交 .env
# ==========================================

# ---- Postgres 容器初始化（非 APP_ 前缀；compose 给 postgres 服务用）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wood-passage-creator_db

# ---- Redis 容器口令（可空=无密码）----
REDIS_PASSWORD=

# ---- 应用密钥（Go / Viper：APP_ 前缀）----
APP_SESSION_SECRET=change-me-session-secret
APP_LLM_API_KEY=
APP_PEXELS_API_KEY=

# 说明：
# - llm.base_url / llm.model / log_level 等 → 改 config.yml
# - compose 已固定 APP_DATABASE_HOST=postgres、APP_REDIS_HOST=redis
# - 本地直接 go run 时不需要 compose 拓扑变量，读 config.yml 的 localhost 即可

# ---- 可选配图 / 对象存储密钥 ----
# APP_NANO_BANANA_API_KEY=
# Cloudflare R2（S3 兼容）；account_id / bucket / public_base_url 写 config.yml
# APP_R2_ACCESS_KEY_ID=
# APP_R2_SECRET_ACCESS_KEY=

# ---- 说明（架构）----
# - 业务默认 / 模型名 / URL：config.yml
# - 密钥：本文件对应的 .env（APP_*）
# - 本地 go run：通常只需填 APP_SESSION_SECRET 与 LLM/配图密钥；DB/Redis 用 config.yml 的 localhost
# - 跨 module 事务：进程启动时 database.InitTxManager，业务调 port.WithinTx（无需 env）
